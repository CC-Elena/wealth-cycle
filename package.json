{
  "name": "stock-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "build": "pnpm --filter \"./apps/*\" run build",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "repomix": "repomix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "repomix": "latest",
    "typescript": "^5.9.3"
  }
}
